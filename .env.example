# ---------- Database (Neon Postgres, pgvector enabled) ----------
# Pooled host (contains -pooler), used at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require&pgbouncer=true"
# Direct host, used only for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---------- Secrets ----------
# 32 random bytes, base64:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Shared key for the Naukri extension (16+ random chars). Paste the same value into the extension's Platform tab.
EXTENSION_API_KEY=
# Recruiter the extension uploads belong to (defaults to DEV_RECRUITER_EMAIL)
# EXTENSION_RECRUITER_EMAIL=

# ---------- AI (all optional: without keys everyone gets an offline Quick score) ----------
# These are the PLATFORM's keys: the fallback. Every HR can add their OWN Groq / Gemini key in Settings, and those are used first.
GEMINI_API_KEY=
GROQ_API_KEY=
# GROQ_MODELS=
LLM_PROVIDER_ORDER=groq,gemini
LLM_MODEL=gemini-flash-latest
# LLM_FALLBACK_MODELS=
EMBEDDING_MODEL=gemini-embedding-001
EVAL_CONCURRENCY=2
AI_RESCORE_TOP_N=30

# ---------- Sources ----------
# Only used by `npx prisma db seed`
GITHUB_PAT=
APIFY_API_TOKEN=
APIFY_GOOGLE_SEARCH_ACTOR=apify~google-search-scraper
APIFY_QUERIES_PER_RUN=10
APIFY_MAX_PAGES_PER_QUERY=1
XRAY_MAX_QUERIES=60
CUTSHORT_API_KEY=
CUTSHORT_MAX_SEARCHES_PER_RUN=3
CUTSHORT_MAX_UNLOCKS_PER_RUN=3
# APOLLO_API_KEY=
SOURCING_MAX_PROFILES=30

# ---------- Sign-in with Google (company accounts only) ----------
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (type: Web application).
# Authorised redirect URI:  https://YOUR-SITE/api/auth/google/callback   (and http://localhost:3000/api/auth/google/callback for local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only addresses on this domain can sign in with Google.
ALLOWED_EMAIL_DOMAIN=xsassociates.com
# These e-mails become admin / manager the first time they sign in (comma separated). The very first person to sign in becomes admin.
ADMIN_EMAILS=
MANAGER_EMAILS=
# Public address of the site, only if the request URL is not the public one (e.g. https://hunt.xsassociates.com)
# APP_URL=
# Keep e-mail + password login next to Google (default true). Set false to allow Google only.
ALLOW_PASSWORD_LOGIN=true

# ---------- Behaviour ----------
# Local dev only: skips login and uses the seeded recruiter. Never true in production.
# Must be false (or unset) on Vercel: DEV_AUTH is refused in production. Create users with: npm run user:create
DEV_AUTH=false
# TEMPORARY testing only: true = no login at all (anyone with the URL sees everything)
OPEN_ACCESS=false
# Signs the login cookie; defaults to TOKEN_ENCRYPTION_KEY
# AUTH_SECRET=
DEV_RECRUITER_EMAIL=recruiter@talentgraph.dev
EMBEDDED_WORKER=true
LOG_LEVEL=info
WATERMARK_TEXT=CONFIDENTIAL
