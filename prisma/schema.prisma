// TalentGraph data model.
// Conventions:
//  - Tables are snake_case plural (@@map), columns stay camelCase.
//    In raw SQL always quote column names: m."jobId", c."githubId".
//  - Every id is a UUID generated by the DATABASE (gen_random_uuid()),
//    so raw INSERT ... ON CONFLICT statements work without Prisma.
//  - updatedAt has a DB default too, so raw SQL must still set updatedAt = now() on UPDATE.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Runtime connection: Neon POOLED host (-pooler).
  url        = env("DATABASE_URL")
  // Migrations connection: Neon DIRECT host.
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum BatchStatus {
  queued
  running
  completed
  failed
}

enum MatchStatus {
  pending
  completed
  failed
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  recruiters       Recruiter[]
  jobs             JobDescription[]
  resumeCandidates ResumeCandidate[]

  @@index([createdAt])
  @@index([updatedAt])
  @@map("organizations")
}

model Recruiter {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  email          String   @unique
  name           String
  /// scrypt hash ("scrypt$<salt hex>$<hash hex>") used by the email + password login. null = cannot sign in.
  passwordHash   String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthTokens      OAuthToken[]
  jobs             JobDescription[]
  ingestionBatches IngestionBatch[]
  resumeUploads    ResumeCandidate[]

  @@index([organizationId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("recruiters")
}

/// Third-party tokens (e.g. the recruiter's GitHub token).
/// encryptedToken format: "v1:<iv>:<authTag>:<ciphertext>" (AES-256-GCM, base64 parts).
model OAuthToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recruiterId    String    @db.Uuid
  provider       String
  encryptedToken String    @db.Text
  scopes         String[]  @default([])
  expiresAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  recruiter Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, provider])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("oauth_tokens")
}

model JobDescription {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                       @db.Uuid
  createdById     String                       @db.Uuid
  title           String
  description     String                       @db.Text
  requiredSkills  String[]                     @default([])
  preferredSkills String[]                     @default([])
  /// Programming languages used for the GitHub search (e.g. ["Python"]).
  languages       String[]                     @default([])
  /// One GitHub search is run per location (qualifiers are ANDed by GitHub).
  locations       String[]                     @default([])
  remoteAllowed   Boolean                      @default(false)
  /// Extra JD details (filled when a job is created from a pasted / uploaded JD).
  technologies    String[]                     @default([])
  /// Skills the JD explicitly wants hands-on experience in (Resume Match checks for real project use).
  handsOn         String[]                     @default([])
  experienceYears Float?
  seniority       String?
  workMode        String?
  employmentType  String?
  /// manual | pasted | uploaded
  source          String                       @default("manual")
  sourceFileName  String?
  rawText         String?                      @db.Text
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                     @default(now()) @updatedAt @db.Timestamptz(3)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        Recruiter         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  batches          IngestionBatch[]
  matchScores      MatchScore[]
  resumeCandidates ResumeCandidate[]

  @@index([organizationId, createdAt])
  @@index([createdById])
  @@index([updatedAt])
  @@map("job_descriptions")
}

model Candidate {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// null for candidates sourced from LinkedIn.
  githubId        BigInt?                      @unique
  /// "github" | "linkedin" | "cutshort"
  source          String                       @default("github")
  /// LinkedIn public identifier (/in/<id>), lower case. null for GitHub candidates.
  linkedinId      String?                      @unique
  /// Cutshort talentCardId for candidates sourced from Cutshort. null otherwise.
  cutshortId      String?                      @unique
  /// Stable Naukri/Resdex candidate key sent by the browser extension. null otherwise.
  naukriId        String?                      @unique
  /// Naukri extras shown on the card (free text exactly as Resdex shows it, e.g. "12 Lacs", "30 days").
  ctc             String?
  noticePeriod    String?
  /// The resume is stored INSIDE the platform. Naukri CV links need a live Resdex session and 404 outside it,
  /// so the extension uploads the bytes (resumeData) or, failing that, the CV text (resumeText).
  resumeFileName  String?
  resumeFileType  String?
  resumeData      Bytes?
  resumeText      String?                      @db.Text
  resumeCapturedAt DateTime?                   @db.Timestamptz(3)
  /// GitHub login, or the LinkedIn public identifier for LinkedIn candidates.
  login           String
  headline        String?
  skills          String[]                     @default([])
  experienceYears Float?
  // ---- contact data for recruiter outreach. Never sent to the AI. ----
  emails          String[]                     @default([])
  phoneNumbers    String[]                     @default([])
  /// Primary Indian mobile number for outreach, E.164 ("+919876543210"). null when none was found.
  /// Read free from Google snippets by regex; only Tier 1 candidates ever get a paid enrichment lookup.
  phone           String?
  /// Where `phone` came from: "serp_regex" | "enrichment:<provider>". null when there is no phone.
  phoneSource     String?
  personalWebsite String?
  otherLinks      String[]                     @default([])
  name            String?
  avatarUrl       String?
  profileUrl      String
  bio             String?                      @db.Text
  location        String?
  githubCreatedAt DateTime?                    @db.Timestamptz(3)
  yearsActive     Float?
  /// Shares by bytes, e.g. { "Python": 0.62, "TypeScript": 0.21 }
  topLanguages    Json                         @default("{}")
  topics          String[]                     @default([])
  /// Stays null until enrichment (Phase 6). We never request the GitHub `email` field.
  publicEmail     String?
  profileText     String?                      @db.Text
  embedding       Unsupported("vector(1536)")?
  lastIngestedAt  DateTime?                    @db.Timestamptz(3)
  createdAt       DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                     @default(now()) @updatedAt @db.Timestamptz(3)

  matchScores MatchScore[]

  @@index([login])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("candidates")
}

model IngestionBatch {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId              String      @db.Uuid
  requestedById      String      @db.Uuid
  status             BatchStatus @default(queued)
  maxProfiles        Int         @default(100)
  /// "github" (search) or "linkedin" (Google X-Ray search via Apify, or the URLs in linkedinUrls).
  source             String      @default("github")
  linkedinUrls       String[]    @default([])
  profilesFound      Int         @default(0)
  candidatesUpserted Int         @default(0)
  embeddedCount      Int         @default(0)
  evaluatedCount     Int         @default(0)
  failedCount        Int         @default(0)
  /// How many candidates this run sends to Gemini (already-scored candidates are skipped).
  evaluationTotal    Int         @default(0)
  error              String?     @db.Text
  startedAt          DateTime?   @db.Timestamptz(3)
  finishedAt         DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  job         JobDescription @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requestedBy Recruiter      @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  matchScores MatchScore[]

  // The worker polls: WHERE status = 'queued' ORDER BY createdAt
  @@index([status, createdAt])
  @@index([jobId, createdAt])
  @@index([requestedById])
  @@index([updatedAt])
  @@map("ingestion_batches")
}

model MatchScore {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String      @db.Uuid
  candidateId   String      @db.Uuid
  batchId       String?     @db.Uuid
  /// 0-100. Null while pending/failed. Range enforced by a CHECK constraint (see migration).
  score         Int?
  matchedSkills String[]    @default([])
  missingSkills String[]    @default([])
  status        MatchStatus @default(pending)
  model         String?
  error         String?     @db.Text
  /// Recruiter's shortlist flag (kept when a candidate is re-scored).
  shortlisted   Boolean     @default(false)
  /// One-line fit reasoning (Naukri extension: the analysis headline shown on the card).
  note          String?     @db.Text
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  job       JobDescription  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  batch     IngestionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([jobId, candidateId])
  @@index([jobId, score(sort: Desc)])
  @@index([jobId, shortlisted])
  @@index([candidateId])
  @@index([batchId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("match_scores")
}

/// Resume Match module: a resume uploaded against a job and scored skill by skill.
model ResumeCandidate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  jobId          String   @db.Uuid
  uploadedById   String   @db.Uuid
  fileName       String
  /// pdf | docx | doc | txt
  fileType       String
  fileData       Bytes?
  resumeText     String   @db.Text
  name           String?
  summary        String?  @db.Text
  candidateYears Float?
  requiredYears  Float?
  /// [{ name, type: required|preferred|other, status: matched|partial|missing, evidence, handsOn?, handsOnShown? }]
  skills         Json     @default("[]")
  score          Int      @default(0)
  reqHit         Float    @default(0)
  reqTotal       Int      @default(0)
  /// Model that analysed the resume, or "heuristic" for the offline keyword scorer.
  scoredBy       String
  shortlisted    Boolean  @default(false)
  /// none | masked | failed
  maskStatus     String   @default("none")
  maskedText     String?  @db.Text
  maskError      String?  @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          JobDescription @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadedBy   Recruiter      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([jobId, score(sort: Desc)])
  @@index([organizationId, createdAt])
  @@index([jobId, shortlisted])
  @@index([uploadedById])
  @@map("resume_candidates")
}
