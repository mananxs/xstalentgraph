{
  "name": "resdex-copilot-extension",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build -- --watch",
    "build": "vite build && vite build --config vite.content.config.ts && vite build --config vite.agent.config.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit.test.ts",
    "test:backend": "tsx --test tests/backend.integration.test.ts",
    "test:worker": "tsx --test tests/agent-worker.integration.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
