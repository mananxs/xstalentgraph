{
  "manifest_version": 3,
  "name": "XS-NaukriAI",
  "version": "1.1.0",
  "description": "Passive AI match scoring for Naukri Resdex candidates, per-HR login, Naukri search sync and an Analyzed-only view \u2014 powered by your XS-NaukriAI workspace.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open XS-NaukriAI"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://resdex.naukri.com/*",
    "http://localhost:3000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://resdex.naukri.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
