{
  "manifest_version": 3,
  "name": "XS-Hunt",
  "version": "2.1.0",
  "description": "XS-Hunt for Naukri Resdex: your XS-Hunt workspace drives sourcing in your own signed-in Resdex session, scores candidates with your job rubric, and stores approved profiles and resumes.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open XS-Hunt"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://resdex.naukri.com/*",
    "http://localhost:3000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://resdex.naukri.com/*"
      ],
      "js": [
        "content.js",
        "agent.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}