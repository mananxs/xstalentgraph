{
  "name": "talentgraph",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "github:smoke": "tsx --env-file=.env scripts/github-smoke.ts",
    "test": "tsx --test src/server/*/*.test.ts src/server/*/*/*/*.test.ts src/lib/*.test.ts src/components/landing/*.test.ts src/server/*.test.ts",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "user:create": "tsx --env-file=.env scripts/create-user.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@prisma/client": "^6.19.3",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.68.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.29",
    "p-limit": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^1.9.1",
    "word-extractor": "^1.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
